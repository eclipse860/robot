[Unit]
Description=Remote Robot WebSocket Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=phil
WorkingDirectory=/home/phil/robot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/phil/robot-env/bin/python /home/phil/robot/network/ws_server.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
